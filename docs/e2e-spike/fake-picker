#!/bin/sh
# dmenu-style: log the request, answer from $FAKE_PICKER_ANSWERS (one regex per call, consumed in order)
input=$(cat)
{ echo "ARGS: $*"; echo "$input"; echo "--"; } >> "$FAKE_PICKER_LOG"
ans=$(head -n1 "$FAKE_PICKER_ANSWERS" 2>/dev/null); sed -i 1d "$FAKE_PICKER_ANSWERS" 2>/dev/null
[ "$ans" = CANCEL ] && exit 1
printf '%s\n' "$input" | grep -E -m1 -- "${ans:-.}"
