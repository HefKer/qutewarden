#!/usr/bin/env python3
"""Regenerate src/qutewarden/equivalent_domains.json from Bitwarden's server (ADR-0006).

Usage: scripts/update-equivalent-domains [REF]

Reads the global Equivalent domains from
bitwarden/server/src/Core/Utilities/StaticStore.cs at REF (default: main),
pinned to the commit REF resolves to, and writes them with a header naming
the source and its licence (AGPL-3.0). Run it before each release.
"""

from __future__ import annotations

import json
import re
import sys
import urllib.request
from pathlib import Path

REPO = "bitwarden/server"
PATH = "src/Core/Utilities/StaticStore.cs"
OUT = Path(__file__).resolve().parent.parent / "src" / "qutewarden" / "equivalent_domains.json"

_GROUP = re.compile(
    r"GlobalDomains\.Add\(\s*GlobalEquivalentDomainsType\.(\w+)\s*,"
    r"\s*new\s+List<string>\s*\{([^}]*)\}\s*\)\s*;")
_STRING = re.compile(r'"([^"\\]*)"')


def _get(url: str, accept: str | None = None) -> str:
    request = urllib.request.Request(url, headers={"Accept": accept} if accept else {})
    with urllib.request.urlopen(request, timeout=30) as response:
        return response.read().decode("utf-8-sig")


def parse(source: str) -> list[list[str]]:
    """The groups in StaticStore.cs, in file order, each a list of base domains."""
    groups = [_STRING.findall(body) for _, body in _GROUP.findall(source)]
    if not groups or not all(groups):
        raise SystemExit("no Equivalent domains found; has StaticStore.cs changed shape?")
    return groups


def main(argv: list[str]) -> int:
    ref = argv[1] if len(argv) > 1 else "main"
    sha = _get(f"https://api.github.com/repos/{REPO}/commits/{ref}",
               accept="application/vnd.github.sha").strip()
    if not re.fullmatch(r"[0-9a-f]{40}", sha):
        raise SystemExit(f"can't resolve {ref!r} to a commit")
    groups = parse(_get(f"https://raw.githubusercontent.com/{REPO}/{sha}/{PATH}"))
    header = {
        "_comment": "Generated by scripts/update-equivalent-domains; do not edit by hand.",
        "source": f"https://github.com/{REPO}/blob/{sha}/{PATH}",
        "license": "AGPL-3.0 (Bitwarden Inc.); see the README",
    }
    lines = [f"  {json.dumps(k)}: {json.dumps(v)}," for k, v in header.items()]
    rows = ",\n".join(f"    {json.dumps(group)}" for group in groups)
    OUT.write_text("{\n" + "\n".join(lines) + '\n  "groups": [\n' + rows + "\n  ]\n}\n",
                   encoding="utf-8")
    print(f"wrote {len(groups)} groups from {sha[:12]} to {OUT}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
